<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cœur portable du lecteur : pilotage de libmpv, file d'attente, réglages (aucune dépendance NuGet) -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BJMPCPlayer.Core</RootNamespace>
  </PropertyGroup>
</Project>
