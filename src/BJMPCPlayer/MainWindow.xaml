<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BJMPCPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BJMPC Player">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
          PreviewKeyDown="Root_PreviewKeyDown" PointerMoved="Root_PointerMoved">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de titre (zone de déplacement de la fenêtre) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="Assets/Logo.png" Width="18" Height="18" />
                <TextBlock x:Name="AppTitle" Text="BJMPC Player" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        PaneDisplayMode="Left" OpenPaneLength="260" IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Accueil" Tag="home" Icon="Home" />
                <NavigationViewItem Content="Lecture en cours" Tag="now">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Musique" Tag="music" Icon="Audio" />
                <NavigationViewItem Content="Vidéos" Tag="videos" Icon="Video" />
                <NavigationViewItem Content="File d'attente" Tag="queue" Icon="List" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <InfoBar x:Name="Info" Grid.Row="2" IsOpen="False" Severity="Error" Margin="16,0,16,8" />

        <!-- Barre de lecture -->
        <Grid x:Name="Transport" Grid.Row="3" Height="96" Padding="16,6,16,6"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
              PointerEntered="Transport_PointerEntered" PointerExited="Transport_PointerExited">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="*" />
                <ColumnDefinition Width="2*" MaxWidth="760" />
                <ColumnDefinition x:Name="RightCol" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pochette + titre : ouvre « Lecture en cours » -->
            <Button x:Name="NowPlayingButton" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="4"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Left" Click="NowPlayingButton_Click"
                    ToolTipService.ToolTip="Lecture en cours">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="56" Height="56" CornerRadius="6" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="22" Opacity="0.6" />
                            <Image Source="{x:Bind Player.Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Player.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Commandes + progression -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <ToggleButton x:Name="ShuffleButton" Style="{StaticResource DefaultToggleButtonStyle}" Background="Transparent" BorderThickness="0"
                                  Width="40" Height="40" Padding="0" CornerRadius="20" Click="Shuffle_Click"
                                  IsChecked="{x:Bind Player.Shuffle, Mode=OneWay}" ToolTipService.ToolTip="Lecture aléatoire">
                        <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                    </ToggleButton>
                    <Button Style="{StaticResource TransportButton}" Click="Previous_Click" ToolTipService.ToolTip="Précédent (P)">
                        <FontIcon Glyph="&#xE892;" FontSize="16" />
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Width="44" Height="44" CornerRadius="22" Padding="0"
                            Click="Play_Click" ToolTipService.ToolTip="Lecture / pause (Espace)">
                        <FontIcon Glyph="{x:Bind PlayGlyph(Player.IsPlaying), Mode=OneWay}" FontSize="18" />
                    </Button>
                    <Button Style="{StaticResource TransportButton}" Click="Next_Click" ToolTipService.ToolTip="Suivant (N)">
                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                    </Button>
                    <ToggleButton x:Name="RepeatButton" Style="{StaticResource DefaultToggleButtonStyle}" Background="Transparent" BorderThickness="0"
                                  Width="40" Height="40" Padding="0" CornerRadius="20" Click="Repeat_Click"
                                  IsChecked="{x:Bind RepeatOn(Player.Repeat), Mode=OneWay}" ToolTipService.ToolTip="Répéter">
                        <FontIcon Glyph="{x:Bind RepeatGlyph(Player.Repeat), Mode=OneWay}" FontSize="16" />
                    </ToggleButton>
                </StackPanel>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Clock(Player.Position), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="{x:Bind SafeMax(Player.Duration), Mode=OneWay}"
                            IsThumbToolTipEnabled="False" VerticalAlignment="Center" ValueChanged="SeekSlider_ValueChanged" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Clock(Player.Duration), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" MinWidth="44" />
                </Grid>
            </StackPanel>

            <!-- Volume, pistes, options, mini-lecteur, plein écran -->
            <StackPanel x:Name="RightTools" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                <Button Style="{StaticResource TransportButton}" ToolTipService.ToolTip="Volume (M : muet)">
                    <FontIcon Glyph="{x:Bind VolumeGlyph(Player.Volume, Player.Muted), Mode=OneWay}" FontSize="16" />
                    <Button.Flyout>
                        <Flyout Placement="Top" ShouldConstrainToRootBounds="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" Width="300">
                                <Button Style="{StaticResource TransportButton}" Click="Mute_Click">
                                    <FontIcon Glyph="{x:Bind VolumeGlyph(Player.Volume, Player.Muted), Mode=OneWay}" FontSize="16" />
                                </Button>
                                <Slider x:Name="VolumeSlider" Width="190" Minimum="0" Maximum="150" StepFrequency="1" VerticalAlignment="Center"
                                        Value="{x:Bind Player.Volume, Mode=OneWay}" ValueChanged="VolumeSlider_ValueChanged" />
                                <TextBlock Text="{x:Bind Percent(Player.Volume), Mode=OneWay}" VerticalAlignment="Center" Width="40" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Style="{StaticResource TransportButton}" ToolTipService.ToolTip="Audio et sous-titres">
                    <FontIcon Glyph="&#xE7F0;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="TracksMenu" Placement="Top" ShouldConstrainToRootBounds="False" Opening="TracksMenu_Opening" />
                    </Button.Flyout>
                </Button>
                <Button Style="{StaticResource TransportButton}" ToolTipService.ToolTip="Mini-lecteur" Click="Mini_Click">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource TransportButton}" ToolTipService.ToolTip="Plein écran (F11)" Click="FullScreen_Click">
                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource TransportButton}" ToolTipService.ToolTip="Plus d'options">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Top" ShouldConstrainToRootBounds="False">
                            <MenuFlyoutItem Text="Ouvrir des fichiers…" Click="OpenFiles_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Ouvrir un dossier…" Click="OpenFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Ouvrir une URL…" Click="OpenUrl_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="Vitesse de lecture">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xEC4A;" /></MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="0,5×" Tag="0.5" Click="Speed_Click" />
                                <MenuFlyoutItem Text="0,75×" Tag="0.75" Click="Speed_Click" />
                                <MenuFlyoutItem Text="Normale" Tag="1" Click="Speed_Click" />
                                <MenuFlyoutItem Text="1,25×" Tag="1.25" Click="Speed_Click" />
                                <MenuFlyoutItem Text="1,5×" Tag="1.5" Click="Speed_Click" />
                                <MenuFlyoutItem Text="2×" Tag="2" Click="Speed_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem Text="Arrêter" Click="Stop_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71A;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
