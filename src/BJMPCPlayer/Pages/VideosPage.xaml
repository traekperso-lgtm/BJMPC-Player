<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BJMPCPlayer.Pages.VideosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:BJMPCPlayer.Services"
    NavigationCacheMode="Required">

    <Grid Padding="40,24,40,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Vidéos" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Rescan_Click" ToolTipService.ToolTip="Actualiser">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            <TextBlock x:Name="Status" Opacity="0.7" VerticalAlignment="Center" />
        </StackPanel>
        <GridView x:Name="VideoGrid" Grid.Row="2" IsItemClickEnabled="True" ItemClick="VideoGrid_ItemClick" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="svc:VideoFile">
                    <StackPanel Width="256" Spacing="6" Margin="0,0,12,18">
                        <Border Width="256" Height="144" CornerRadius="8" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE714;" FontSize="40" Opacity="0.35" />
                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
