<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BJMPCPlayer.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BJMPCPlayer.Core"
    NavigationCacheMode="Required">

    <Grid Padding="40,24,40,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="File d'attente" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Glissez les titres pour changer l'ordre." Opacity="0.65" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="Add_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Ajouter des fichiers" />
                    </StackPanel>
                </Button>
                <Button Click="Clear_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Vider" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <ListView x:Name="List" Grid.Row="1" ItemsSource="{x:Bind Player.QueueItems}" SelectedIndex="{x:Bind Player.CurrentIndex, Mode=OneWay}"
                  CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="List_DragItemsCompleted"
                  IsItemClickEnabled="True" ItemClick="List_ItemClick" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:QueueItem">
                    <Grid ColumnSpacing="16" Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Artist, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind DurationText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Click="Remove_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Retirer">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
