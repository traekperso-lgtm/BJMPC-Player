<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BJMPCPlayer.Pages.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:BJMPCPlayer.Services"
    NavigationCacheMode="Required">

    <Grid Padding="40,24,40,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Musique" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="Search" PlaceholderText="Rechercher" QueryIcon="Find" Width="260" TextChanged="Search_TextChanged" />
                <Button Style="{StaticResource AccentButtonStyle}" Click="ShuffleAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                        <TextBlock Text="Tout en aléatoire" />
                    </StackPanel>
                </Button>
                <Button Click="Rescan_Click" ToolTipService.ToolTip="Actualiser la bibliothèque">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem x:Name="TabSongs" Text="Titres" IsSelected="True" />
                <SelectorBarItem x:Name="TabAlbums" Text="Albums" />
            </SelectorBar>
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <ListView x:Name="SongList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="SongList_ItemClick" SelectionMode="Single"
                  RightTapped="SongList_RightTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="svc:Song">
                    <Grid ColumnSpacing="16" Padding="0,4" Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="4" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Artist}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Album}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                        <TextBlock Grid.Column="4" Text="{x:Bind DurationText}" VerticalAlignment="Center" Opacity="0.75" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <GridView x:Name="AlbumGrid" Grid.Row="2" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="AlbumGrid_ItemClick" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="svc:Album">
                    <StackPanel Width="168" Spacing="6" Margin="0,0,8,16">
                        <Border Width="168" Height="168" CornerRadius="8" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE93C;" FontSize="48" Opacity="0.35" />
                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
