<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BJMPCPlayer.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <!-- Zone vidéo : la fenêtre de libmpv est posée exactement dessus -->
        <Border x:Name="VideoArea" Background="Black" Visibility="{x:Bind Vis(Player.HasVideo), Mode=OneWay}" />

        <!-- Audio : pochette en grand sur fond flouté -->
        <Grid Visibility="{x:Bind AudioVis(Player.HasVideo, Player.HasMedia), Mode=OneWay}">
            <Image Source="{x:Bind Player.Cover, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.55" />
            <Rectangle>
                <Rectangle.Fill>
                    <AcrylicBrush TintColor="{ThemeResource SolidBackgroundFillColorBase}" TintOpacity="0.55" FallbackColor="{ThemeResource SolidBackgroundFillColorBase}" />
                </Rectangle.Fill>
            </Rectangle>
            <Grid Padding="48" ColumnSpacing="48" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="320" Height="320" CornerRadius="10" Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="96" Opacity="0.4" />
                        <Image Source="{x:Bind Player.Cover, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" MaxWidth="560">
                    <TextBlock Text="{x:Bind Player.Title, Mode=OneWay}" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" MaxLines="3" />
                    <TextBlock Text="{x:Bind Player.Subtitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Opacity="0.85" />
                    <TextBlock Text="{x:Bind Player.Album, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.65" />
                    <ProgressRing IsActive="{x:Bind Player.Buffering, Mode=OneWay}" HorizontalAlignment="Left" Width="24" Height="24" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Rien en lecture -->
        <StackPanel Visibility="{x:Bind EmptyVis(Player.HasMedia), Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <FontIcon Glyph="&#xE768;" FontSize="64" Opacity="0.35" />
            <TextBlock Text="Rien en lecture" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Ouvrez un fichier ou glissez-le ici." Opacity="0.7" HorizontalAlignment="Center" />
            <Button Content="Ouvrir des fichiers" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="Open_Click" />
        </StackPanel>
    </Grid>
</Page>
