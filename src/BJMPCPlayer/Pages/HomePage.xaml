<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BJMPCPlayer.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BJMPCPlayer.Pages"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="40,24,40,40" Spacing="28" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Accueil" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Musique, films, séries, radios : tous les formats, avec un son WASAPI de qualité." Opacity="0.75" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Click="OpenFiles_Click">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE8E5;" FontSize="28" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Ouvrir des fichiers" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Audio, vidéo, listes M3U (Ctrl+O)" Opacity="0.7" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Click="OpenFolder_Click">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE8B7;" FontSize="28" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Ouvrir un dossier" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Lit tout le dossier et ses sous-dossiers" Opacity="0.7" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="20" Click="OpenUrl_Click">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE71B;" FontSize="28" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Ouvrir une URL" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Radios, flux, vidéos en ligne" Opacity="0.7" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock Text="Récemment lus" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="EmptyRecent" Text="Rien pour l'instant : glissez un fichier sur la fenêtre pour commencer." Opacity="0.6" />
                <ListView x:Name="RecentList" IsItemClickEnabled="True" ItemClick="RecentList_ItemClick" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:RecentEntry">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Opacity="0.8" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Folder}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
